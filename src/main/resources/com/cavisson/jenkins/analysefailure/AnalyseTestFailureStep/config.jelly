<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">

  <f:entry title="${%Connection Mode}" field="connectionMode">
    <f:select default="direct"/>
  </f:entry>

  <f:entry title="${%Base URL}" field="baseUrl">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%API Token}" field="apiTokenCredentialId">
    <c:select/>
  </f:entry>
  <f:entry title="${%Service Connection ID}" field="cavServiceConnectionId">
    <f:textbox/>
  </f:entry>

  <f:entry title="${%Test Suite Run Number}" field="tsrNumber">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%Test Run Number}" field="trNumber">
    <f:textbox/>
  </f:entry>

  <f:entry title="${%Scenario}" field="scenario">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%Project}" field="project">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%Sub Project}" field="subProject">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%User Name}" field="userName">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%Work Profile Name}" field="workProfileName">
    <f:textbox/>
  </f:entry>

  <f:entry title="${%Concurrency}" field="concurrency">
    <f:number default="1" min="1" max="8"/>
  </f:entry>

</j:jelly>
