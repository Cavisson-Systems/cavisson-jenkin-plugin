<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core"
         xmlns:f="/lib/form"
         xmlns:c="/lib/credentials"
         xmlns:st="jelly:stapler">

  <!-- Connection -->
  <f:section title="Connection">
    <f:entry title="Service Connection"
             field="cavServiceConnectionId"
             description="Jenkins Credential ID of the Cav AI Service Connection (Dashboard Server URL, Cav Token). Configure it under Manage Jenkins &gt; Credentials.">
      <c:select/>
    </f:entry>

    <f:entry title="Application URL"
             field="applicationUrl"
             description="URL of the application under test. Example: https://www.saucedemo.com">
      <f:textbox placeholder="https://www.saucedemo.com" checkMethod="post"/>
    </f:entry>
  </f:section>

  <!-- Execution Source -->
  <f:section title="Execution Source">
    <div id="cavAiExecSource">

    <f:entry title="Execution Source"
             field="prdSourceType"
             description="Where the PRD/epic content comes from. Local File Upload: upload a file from the browser. Git Repository: clone a repository and locate the PRD inside it. Epic Integration: fetch stories from a JIRA/Azure DevOps epic via the AI server.">
      <f:select id="cavAiExecSourceType"/>
    </f:entry>

    <!-- Local File Upload: source-specific fields only -->
    <div class="exec-source-group exec-source-local">
      <f:entry title="PRD File Parameter Name"
               field="prdParameterName"
               description="Name of the Jenkins file parameter. The pipeline must declare: file(name: 'PRD_FILE_UPLOAD', ...). Default: PRD_FILE_UPLOAD.">
        <f:textbox default="PRD_FILE_UPLOAD"/>
      </f:entry>

      <f:entry title="PRD File Path (Legacy - Optional)"
               field="prdFile"
               description="Optional fallback: path to a PRD file already in the Jenkins workspace. Leave empty when using file upload.">
        <f:textbox placeholder="Leave empty when using file upload"/>
      </f:entry>
    </div>

    <!-- Git Repository: source-specific fields only -->
    <div class="exec-source-group exec-source-git">
      <f:entry title="Git Repository URL"
               field="gitRepoUrl"
               description="Full Git repository URL. Example: https://github.com/org/repo.git. Required when Execution Source is Git Repository.">
        <f:textbox placeholder="https://github.com/org/repo.git" checkMethod="post"/>
      </f:entry>

      <f:entry title="Git Branch"
               field="gitBranch"
               description="Branch to clone. Default: main.">
        <f:textbox default="main" placeholder="main"/>
      </f:entry>

      <f:entry title="PRD File Path in Repository"
               field="gitPrdPath"
               description="Relative path to the PRD file inside the repository. Example: docs/SauceDemoTEST.feature. Required when Execution Source is Git Repository.">
        <f:textbox placeholder="docs/MyPRD.feature" checkMethod="post"/>
      </f:entry>

      <f:entry title="Git Integration Name"
               field="gitIntegrationName"
               description="Name of a Git Integration saved in the Cavisson application (Manage Cavisson App &gt; Extension Config &gt; Git Source Code). Its username/PAT are resolved from the server at build time. Required when Execution Source is Git Repository - there is no Jenkins-credential alternative.">
        <f:textbox placeholder="MY_GIT_INTEGRATION" checkMethod="post"/>
      </f:entry>
    </div>

    <!-- Epic Integration: no source-specific fields - falls straight through to the
         common Source Type / Epic Pattern / Integration Name section below -->

    </div>

    <script>
      (function() {
        var container = document.getElementById('cavAiExecSource');
        var select = document.getElementById('cavAiExecSourceType');
        if (!container || !select) { return; }
        function hasClass(el, cls) {
          return (' ' + el.className + ' ').indexOf(' ' + cls + ' ') &gt;= 0;
        }
        function update() {
          var value = (select.value || 'LOCAL').toLowerCase();
          var groups = container.getElementsByTagName('div');
          for (var i = 0; i &lt; groups.length; i++) {
            var g = groups[i];
            if (hasClass(g, 'exec-source-group')) {
              g.style.display = hasClass(g, 'exec-source-' + value) ? '' : 'none';
            }
          }
        }
        select.onchange = update;
        update();
      })();
    </script>
  </f:section>

  <!-- Common Section: exactly one copy, shared by every Execution Source -->
  <f:section title="Source Type / Epic">
    <f:entry title="Source Type"
             field="sourceType"
             description="Platform used for the Epic Pattern / Integration Name fields below.">
      <f:select/>
    </f:entry>

    <f:entry title="Epic Pattern"
             field="jiraEpicPattern"
             description="Epic key or pattern on the platform selected above. Example: EM-527. Required when Execution Source is Epic Integration.">
      <f:textbox placeholder="EM-527"/>
    </f:entry>

    <f:entry title="Integration Name"
             field="jiraIntegrationName"
             description="Name of the saved integration configuration in Cavisson for the platform selected above. Required when Execution Source is Epic Integration.">
      <f:textbox placeholder="JIRA_CONFIG_TEST"/>
    </f:entry>
  </f:section>

  <!-- Advanced Options (collapsed by default, shared by every Execution Source) -->
  <f:advanced title="Advanced Options">

    <f:entry title="Workspace Root"
             field="workspaceRoot"
             description="Root directory on the Cavisson server. Plugin uploads to {workspaceRoot}/agenticAi/aiTestCases. Default: /home/cavisson/work.">
      <f:textbox default="/home/cavisson/work" checkMethod="post"/>
    </f:entry>

    <f:entry title="Project"
             field="project"
             description="Cavisson project name. Default: default.">
      <f:textbox default="default" checkMethod="post"/>
    </f:entry>

    <f:entry title="Sub Project"
             field="subProject"
             description="Cavisson sub-project name. Default: default.">
      <f:textbox default="default" checkMethod="post"/>
    </f:entry>

    <f:entry title="Test Suite Name"
             field="testSuiteName"
             description="Name for the generated test suite. If left empty, the plugin auto-generates one (AI_TestSuite_&lt;timestamp&gt;).">
      <f:textbox placeholder="Auto-generated if left empty"/>
    </f:entry>

    <f:entry title="Number Of Test Cases"
             field="numberOfTestCases"
             description="How many test cases to generate (must be greater than 0). Default: 1.">
      <f:number min="1" default="1" checkMethod="post"/>
    </f:entry>

    <f:entry title="Controller Name"
             field="controllerName"
             description="NetStorm controller name. Default: work.">
      <f:textbox default="work" checkMethod="post"/>
    </f:entry>

    <f:entry title="Application Login (Optional)"
             description="Placeholder for a future enhancement - not yet implemented. No validation or backend logic is wired to these fields yet.">
      <f:textbox default="" disabled="true" placeholder="Not yet implemented"/>
    </f:entry>

    <f:entry title="Username" field="username">
      <f:textbox/>
    </f:entry>

    <f:entry title="Password" field="password">
      <f:password/>
    </f:entry>

    <f:entry title="Authentication Prompt" field="authenticationPrompt">
      <f:textbox/>
    </f:entry>

    <f:entry title="Tags"
             field="tagsText"
             description="Optional key=value tags, one per line. Example: app=boutique. Default: no tags (field is omitted from the request entirely).">
      <f:textarea/>
    </f:entry>

    <f:entry title="Log Level"
             field="logLevel"
             description="Controls which Agentic AI pipeline events are shown in the Jenkins console. INFO (default): pipeline milestones only. DEBUG: milestones plus detailed execution events. ERROR: only the pipeline start/finish and errors.">
      <f:select/>
    </f:entry>

  </f:advanced>

</j:jelly>

