<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials" xmlns:st="jelly:stapler">

  <st:adjunct includes="com.cavisson.jenkins.connection.toggle"/>

  <f:entry title="${%Connection Mode}" field="connectionMode">
    <f:select default="serviceConnection" clazz="cav-connection-mode"/>
  </f:entry>

  <f:entry title="${%Base URL}" field="baseUrl" class="cav-conn-direct">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%API Token}" field="apiTokenCredentialId" class="cav-conn-direct">
    <c:select/>
  </f:entry>
  <f:entry title="${%Cavisson Security Pipeline Service Connection}" field="cavScanServiceConnection" class="cav-conn-serviceConnection">
    <f:select/>
  </f:entry>

  <f:entry title="${%Scan Type}" field="scanType">
    <f:select default="SAST"
              data-cav-value-controls='{"SAST":["cav-scan-sast"],"SCA":["cav-scan-sca"],"DAST":["cav-scan-dast"]}'/>
  </f:entry>

  <f:entry title="${%Project / Report Name}" field="project">
    <f:textbox default=""/>
  </f:entry>

  <!-- SAST-only fields -->
  <f:entry title="${%Source Base Directory}" field="targetPath" class="cav-scan-sast">
    <f:textbox default="${WORKSPACE}"/>
  </f:entry>

  <!-- SCA-only fields -->
  <f:entry title="${%Registry URL}" field="scaRegistryUrl" class="cav-scan-sca">
    <f:textbox default="local-build.cav-test.com"/>
  </f:entry>
  <f:entry title="${%Repository}" field="scaRepository" class="cav-scan-sca">
    <f:textbox default="boutique"/>
  </f:entry>
  <f:entry title="${%Image Name}" field="scaImageName" class="cav-scan-sca">
    <f:textbox default="adservice"/>
  </f:entry>
  <f:entry title="${%Image Tag}" field="scaImageTag" class="cav-scan-sca">
    <f:textbox default="16"/>
  </f:entry>

  <!-- DAST-only fields -->
  <f:entry title="${%DAST Mode}" field="dastMode" class="cav-scan-dast">
    <f:select default="baseline"/>
  </f:entry>
  <f:entry title="${%DAST Target URL}" field="dastTarget" class="cav-scan-dast">
    <f:textbox default="http://127.0.0.1:3001"/>
  </f:entry>

  <f:advanced>
    <f:entry title="${%Full Docker Image Override}" field="scaTarget" class="cav-scan-sca">
      <f:textbox default=""/>
    </f:entry>
    <f:entry title="${%SCA Report Directory (optional)}" field="scaReportDir" class="cav-scan-sca">
      <f:textbox/>
    </f:entry>
    <f:entry title="${%DAST API Format}" field="dastApiFormat" class="cav-scan-dast">
      <f:select default="openapi"/>
    </f:entry>
    <f:entry title="${%DAST Report Directory (optional)}" field="dastReportDir" class="cav-scan-dast">
      <f:textbox/>
    </f:entry>
    <f:entry title="${%Quality Gate Name (optional)}" field="qualityGate">
      <f:textbox/>
    </f:entry>
    <f:entry title="${%Quality Gate Timeout Seconds}" field="qualityGateTimeout">
      <f:textbox default="120"/>
    </f:entry>
    <f:entry title="${%Kubernetes Scan Status Poll Timeout Seconds (optional)}" field="securityScanStatusTimeout" class="cav-scan-sca cav-scan-dast">
      <f:textbox/>
    </f:entry>
  </f:advanced>

</j:jelly>
